{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@telescript/api-types",
	"version": "0.0.9",
	"description": "TypeScript types for the Telegram Bot API",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc"
	},
	"keywords": [
		"telegram",
		"bot",
		"api"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/telescript/telescript.git",
		"directory": "packages/api-types"
	},
	"bugs": {
		"url": "https://github.com/telescript/telescript/issues"
	},
	"homepage": "https://github.com/telescript/telescript#readme",
	"author": "Synbulat Biishev <me@syjalo.dev>",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=22"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"typescript": "^7.0.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
