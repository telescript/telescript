{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@telescript/bot",
	"version": "0.0.25",
	"description": "Everything to run a Telegram bot: the client with an HTTP requester and long polling",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc"
	},
	"keywords": [
		"telegram",
		"bot",
		"api"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/telescript/telescript.git",
		"directory": "packages/bot"
	},
	"bugs": {
		"url": "https://github.com/telescript/telescript/issues"
	},
	"homepage": "https://github.com/telescript/telescript#readme",
	"author": "Synbulat Biishev <me@syjalo.dev>",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@telescript/client": "workspace:*",
		"@telescript/polling": "workspace:*",
		"@telescript/requester": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^22.19.0",
		"typescript": "^6.0.3"
	},
	"publishConfig": {
		"access": "public"
	}
}
