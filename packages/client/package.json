{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@telescript/client",
	"version": "0.0.25",
	"description": "Telegram bot client: update events, repositories and structures with API actions",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc"
	},
	"keywords": [
		"telegram",
		"bot",
		"api"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/telescript/telescript.git",
		"directory": "packages/client"
	},
	"bugs": {
		"url": "https://github.com/telescript/telescript/issues"
	},
	"homepage": "https://github.com/telescript/telescript#readme",
	"author": "Synbulat Biishev <me@syjalo.dev>",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@telescript/api-types": "workspace:*",
		"@telescript/core": "workspace:*",
		"@telescript/spec": "workspace:*",
		"@telescript/structures": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^25.8.0",
		"typescript": "^6.0.3"
	},
	"publishConfig": {
		"access": "public"
	}
}
