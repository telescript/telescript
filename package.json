{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@telescript/telescript",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"build": "pnpm --recursive run build",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"check": "pnpm run build && pnpm run lint && pnpm run format:check && pnpm run test",
		"check:docs": "node scripts/check-api-docs.mjs"
	},
	"author": "Synbulat Biishev <me@syjalo.dev>",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@11.1.2",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^25.8.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.8.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vitest": "^5.0.5"
	}
}
